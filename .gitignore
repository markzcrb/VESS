# Xcode per-user state
xcuserdata/
*.xcuserstate

# Build output and test results
build/
DerivedData/
*.xcresult

# macOS
.DS_Store

# Local configuration and secrets (see README)
Config/Secrets.xcconfig
*.xcconfig.local

# Screenshots, comparison sheets and clips from the redesign: kept on disk,
# not in git. Notes (*.md) stay tracked. Reference designs are in Redesign/Design/.
Redesign/Captures/**
!Redesign/Captures/**/
!Redesign/Captures/**/*.md

# Recipe photo sources (Figma exports, ~378 MB): kept on disk. The app ships
# the resized copies in VESS/Assets.xcassets/RecipePhotos.
Redesign/RecipePhotos/
